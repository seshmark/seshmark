#!/bin/bash
# Seshmark resolver for Claude Code
#
# Claude Code doesn't expose deep links to specific sessions,
# so this resolver prints instructions to continue the session.
# You can enhance it to open Claude Code in the current directory.

SESSION_ID="$1"

# Try to resume via claude CLI if available
if command -v claude &>/dev/null; then
  echo "Opening Claude Code..."
  echo ""
  echo "Session: ${SESSION_ID}"
  echo ""
  echo "Note: Claude Code doesn't expose session URLs."
  echo "Continue your work in the Claude Code interface."
  echo ""
  claude --version 2>/dev/null || true
else
  echo "Claude Code not found in PATH."
  echo "Install: https://docs.anthropic.com/en/docs/agents-and-tools/claude-code/overview"
  echo ""
  echo "Session: ${SESSION_ID}"
fi
